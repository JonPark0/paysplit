# PaySplit Environment Variables

# Security
JWT_SECRET=your-super-secret-jwt-key-here
ENCRYPTION_KEY=your-32-character-encryption-key-here

# Database
DATABASE_PATH=/app/database/paysplit.db

# Server
NODE_ENV=production
FRONTEND_PORT=8081
BACKEND_PORT=3002

# Upload settings
UPLOAD_PATH=/app/uploads
MAX_FILE_SIZE=20971520

# Cleanup settings
CLEANUP_INTERVAL=86400000
DATA_RETENTION_DAYS=30

# CORS
CORS_ORIGIN=https://beta.nphani.com

# Rate limiting
RATE_LIMIT_WINDOW=900000
RATE_LIMIT_MAX=100
UPLOAD_RATE_LIMIT_MAX=10