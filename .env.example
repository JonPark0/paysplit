# PaySplit Environment Variables

# Security
JWT_SECRET=your-super-secret-jwt-key-here
ENCRYPTION_KEY=your-32-character-encryption-key-here

# Database
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=paysplit
POSTGRES_USER=paysplit
POSTGRES_PASSWORD=change-this-password
DATABASE_URL=postgresql://paysplit:change-this-password@postgres:5432/paysplit
DATABASE_SSL=false

# Server
NODE_ENV=production
FRONTEND_PORT=8081
BACKEND_PORT=3002

# Upload settings
UPLOAD_PATH=/app/uploads
MAX_FILE_SIZE=20971520

# Cleanup settings
CLEANUP_INTERVAL=86400000
DATA_RETENTION_DAYS=30

# CORS
CORS_ORIGIN=https://paysplit.nphani.com

# API rate limiting
RATE_LIMIT_WINDOW=900000
RATE_LIMIT_MAX=120
UPLOAD_RATE_LIMIT_MAX=20
TRUST_PROXY=1

# reCAPTCHA V3 Configuration
RECAPTCHA_SITE_KEY=your-recaptcha-site-key
RECAPTCHA_SECRET_KEY=your-recaptcha-secret-key
RECAPTCHA_THRESHOLD=0.5
RECAPTCHA_REQUIRED=true
RECAPTCHA_TIMEOUT_MS=5000

# OCR Configuration
OCR_PROVIDER=gemini
# Options: 'gemini' or 'ollama'
OCR_REQUEST_TIMEOUT_MS=20000
OCR_MAX_IMAGE_BYTES=8388608

# Gemini API Configuration
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-2.0-flash
GEMINI_OCR_PROMPT="영수증 이미지를 분석하여 다음 JSON 형식으로 응답해주세요: {\"items\": [{\"name\": \"상품명\", \"price\": 가격, \"quantity\": 수량}], \"total\": 총액, \"store\": \"상점명\"} 한국어 텍스트를 정확히 인식하고, 상품명과 가격을 추출해주세요. 가격은 숫자만 반환하세요. JSON 형식으로만 응답해주세요."

# OLLAMA Configuration (backup option)
OLLAMA_URL=http://your-ollama-host:11434
OLLAMA_MODEL=gemma3:latest
OLLAMA_OCR_PROMPT="영수증 이미지를 분석하여 다음 JSON 형식으로 응답해주세요: {\"items\": [{\"name\": \"상품명\", \"price\": 가격, \"quantity\": 수량}], \"total\": 총액, \"store\": \"상점명\"} 한국어 텍스트를 정확히 인식하고, 상품명과 가격을 추출해주세요. 가격은 숫자만 반환하세요."
